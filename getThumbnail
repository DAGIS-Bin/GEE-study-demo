// 1. 定义研究区
var roi = geometry;
Map.centerObject(roi, 14);

// 2. 加载Sentinel-2底图（去云+真彩色合成）
var s2Basemap = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate('2024-05-01', '2024-10-30')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10)) // 筛选云量<10%的影像
  .median() // 合成中位数影像（去云）
  .clip(roi)
  .select(['B4', 'B3', 'B2']) // 红、绿、蓝波段（真彩色）
  .divide(10000); // 归一化到0-1

// 3. 可视化Sentinel-2底图
Map.addLayer(s2Basemap, {min: 0, max: 0.3, gamma: 1.1}, 'Sentinel-2底图');

// 4. 生成预览链接
var s2ThumbParams = {
  region: roi,
  // scale: 10,
  min: 0,
  max: 0.3,
  gamma: 1.1,
  dimensions: 3000,
  format: 'png'
};
var s2Url = s2Basemap.getThumbURL(s2ThumbParams);
print('Sentinel-2底图预览链接：', s2Url);


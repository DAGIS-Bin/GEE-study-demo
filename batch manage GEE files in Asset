import ee
from tqdm import tqdm
import time

# ---------------------------
# 1. 设置云工程project、目标文件夹
# ---------------------------
projectName = ""
folder = ""

# ---------------------------
# 2. 初始化与认证
# ---------------------------
try:
    ee.Initialize(project = projectName)
    print("已连接 Earth Engine。")
except Exception as e:
    print("未检测到登录状态，开始认证...")
    ee.Authenticate()
    ee.Initialize(project = projectName)
    print("认证完成，已连接 Earth Engine。")

# ---------------------------
# 3. 获取文件夹内的所有资产
# ---------------------------
asset_list = ee.data.listAssets({'parent': folder}).get('assets', [])
print(f"找到 {len(asset_list)} 个资产。")

# 过滤条件：type == 'TABLE' 且名字不包含 '_samples'
asset_list = [
    asset for asset in asset_list
    if asset['type'] == 'TABLE' and '_samples' not in asset['name']
]

# ---------------------------
# 4. 批量删除（带进度条）
# ---------------------------
for asset in tqdm(asset_list, desc="正在删除资产", unit="个"):
    asset_id = asset['name']
    try:
        ee.data.deleteAsset(asset_id)
        time.sleep(1)  # 避免 API 调用过快，可根据需要调整
    except Exception as e:
        tqdm.write(f"❌ 删除失败: {asset_id}, 错误: {e}")

print("✅ 批量删除完成")

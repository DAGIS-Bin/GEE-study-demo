function calArea(img, geom) {
  var geom = geom || img.geometry();
  var dict = ee.Image.pixelArea()
    .addBands(img)
    .reduceRegion({
      reducer: ee.Reducer.sum().group({
        groupField: 1,
        groupName: 'class'
      }),
      geometry: geom,
      scale: 10,
      maxPixels: 1e13
    });

  var groups = ee.List(dict.get('groups'));

  var result = groups.map(function(item) {
    item = ee.Dictionary(item);
    var cls = item.get('class');
    var area = ee.Number(item.get('sum')).divide(10000); // m² → ha
    return ee.List([cls, area]);
  });

  return result;
}
